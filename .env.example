# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: set after creating a webhook in the dashboard (Day 3, once deployed)
PAYPAL_WEBHOOK_ID=

# AI (free key from aistudio.google.com)
GEMINI_API_KEY=your_gemini_key
AI_MODEL=gemini-3.5-flash

# Your details, shown on invoices
FREELANCER_NAME=Your Name
DEFAULT_CURRENCY=USD
